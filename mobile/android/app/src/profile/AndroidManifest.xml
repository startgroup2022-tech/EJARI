<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug/profile only: allow plaintext HTTP so the client can be pointed at a
         local backend (http://10.0.2.2:12000 from an emulator, or a LAN address).
         This is deliberately NOT set in the main manifest, so release builds keep
         Android targetSdk 28+ default of cleartext-denied. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
